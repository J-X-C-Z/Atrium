{
  "name": "orca-atrium",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "esbuild worker/src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=worker/dist/main.mjs",
    "build:ui": "node ui/build.mjs",
    "build:core": "sh scripts/build-core.sh",
    "build": "npm run build:core && npm run build:worker && npm run build:ui",
    "typecheck": "tsc --noEmit -p worker",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "pretest": "node scripts/build-test.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.17.1",
    "esbuild": "0.24.2",
    "typescript": "5.7.3"
  }
}
