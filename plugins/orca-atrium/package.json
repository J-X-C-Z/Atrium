{
  "name": "orca-atrium",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "esbuild worker/src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=worker/dist/main.mjs",
    "build:ui": "npm --prefix ui run build",
    "build:core": "sh scripts/build-core.sh",
    "typecheck": "tsc --noEmit -p worker",
    "pretest": "npm run build:worker",
    "test": "node --test test/"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "typescript": "5.7.3"
  }
}
